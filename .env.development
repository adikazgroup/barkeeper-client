NEXT_PUBLIC_BACKEND_URL = http://localhost:8000/api/v1

# SMTP — the contact form sends through these. Fill them in locally; without
# them /api/contact returns a 500 and logs "SMTP is not configured".
SMTP_HOST = smtp.hostinger.com
SMTP_PORT = 465
SMTP_USER =
SMTP_PASS =
MAIL_TO = ask@duffysburgerandwings.com
MAIL_FROM = ask@duffysburgerandwings.com

# ─── Auth (NextAuth v5) ───
# Signs the session cookie. This one is for local work only — production keeps
# its own in the host's secret store. Rotate it and every session is dropped.
AUTH_SECRET = ddTSiUu0dHjbDNxcsXoOS/0c6LFEBdd/G5Xk3h/roto=
AUTH_URL = http://localhost:3000

# Google sign-in. The browser finishes the flow with this ID and the backend
# verifies what comes back, so it is safe to expose. Without it the Google
# button says it is not configured yet.
NEXT_PUBLIC_GOOGLE_CLIENT_ID =

# Apple sign-in. The client ID is the Services ID (not the App ID), and the
# redirect URI has to match the one registered with Apple exactly.
NEXT_PUBLIC_APPLE_CLIENT_ID =
NEXT_PUBLIC_APPLE_REDIRECT_URI = http://localhost:3000/login
