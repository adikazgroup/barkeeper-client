NEXT_PUBLIC_BACKEND_URL = https://api.redchiliburgerandwings.com/api/v1

# SMTP — set SMTP_USER / SMTP_PASS in the host's secret store, not here.
SMTP_HOST = smtp.hostinger.com
SMTP_PORT = 465
MAIL_TO = ask@duffysburgerandwings.com
MAIL_FROM = ask@duffysburgerandwings.com

# ─── Auth (NextAuth v5) ───
# AUTH_SECRET is a secret — set it in the host's secret store, not here.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_URL = https://duffysburgerandwings.com

NEXT_PUBLIC_GOOGLE_CLIENT_ID =

# The Services ID, and a redirect URI registered with Apple exactly as written.
NEXT_PUBLIC_APPLE_CLIENT_ID =
NEXT_PUBLIC_APPLE_REDIRECT_URI = https://duffysburgerandwings.com/login
